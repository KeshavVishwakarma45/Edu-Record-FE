{
  "name": "@edurecords/edu-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node src/seed/seed.js",
    "db:local": "node scripts/localDb.js",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "lint": "eslint ."
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/helpers/setupEnv.js"
    ],
    "testTimeout": 60000,
    "transform": {}
  },
  "dependencies": {
    "bcrypt": "6.0.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "express-rate-limit": "8.7.2",
    "helmet": "8.3.0",
    "joi": "18.3.1",
    "jsonwebtoken": "9.0.3",
    "mongoose": "9.11.4",
    "morgan": "1.12.1",
    "multer": "2.5.0"
  },
  "devDependencies": {
    "cross-env": "10.1.0",
    "jest": "30.5.2",
    "mongodb-memory-server": "11.3.0",
    "supertest": "7.3.1"
  }
}
