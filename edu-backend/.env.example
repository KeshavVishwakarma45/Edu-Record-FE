# Copy this file to .env and fill in the values. Never commit .env.

PORT=5000
NODE_ENV=development

# MongoDB must be a replica set (transactions are required).
# Everyone uses their OWN database on the shared cluster: change only the name after the "/".
#   S1 -> edurecords_s1   S2 -> edurecords_s2   S3 -> edurecords_s3
#   S4 -> edurecords_s4   S5 -> edurecords_s5   Faculty -> edurecords_faculty
# Atlas: the project owner shares the dev cluster link privately, e.g.
#   MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/edurecords_s1
# No Atlas yet? Run `npm run db:local` in another terminal and use:
MONGODB_URI=mongodb://127.0.0.1:27017/edurecords_s1?replicaSet=rs0

# Long random strings, different from each other. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# The React app's address (CORS only allows this origin)
CLIENT_URL=http://localhost:5173

# Private folder for uploaded files. Must NOT be inside any public folder.
UPLOAD_DIR=./uploads

# Password given to every seeded user by `npm run seed` (development only)
SEED_PASSWORD=Edu@12345
